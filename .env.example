# Copy to .env.local and fill in. Never commit real values.

# --- Database (local: `docker compose up -d`, then `npm run db:migrate`) ---------------------
# Postgres owner connection, used only to run migrations.
DATABASE_URL=postgres://pairadox:pairadox@127.0.0.1:54322/pairadox
# PostgREST: the app reads and writes through it. The JWT secret must match PostgREST's.
POSTGREST_URL=http://127.0.0.1:54321
POSTGREST_JWT_SECRET=local-development-only-jwt-secret-0123456789

# --- Sign-in (Auth.js + Google) --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud -> APIs & Services -> Credentials -> OAuth client (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Alibaba DashScope (Qwen). Server only. The key and base URL must be from the same region.
# International/Singapore: https://dashscope-intl.aliyuncs.com/compatible-mode/v1  |  Beijing: https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
